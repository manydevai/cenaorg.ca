RewriteEngine On

# 0. API Endpoints for Stripe and Donation Tracker
RewriteRule ^api/donation-stats/?$ api/donation-stats.php [L,QSA]
RewriteRule ^api/stripe-webhook/?$ api/stripe-webhook.php [L,QSA]

# 0b. Social Crawler Query-String Handling for Magazine (WhatsApp, Facebook, Twitter, iMessage)
RewriteCond %{QUERY_STRING} (?:^|&)lang=pt(?:&|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/magazine/pt.html -f
RewriteRule ^magazine/?$ magazine/pt.html [L]

RewriteCond %{QUERY_STRING} (?:^|&)lang=en(?:&|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/magazine/en.html -f
RewriteRule ^magazine/?$ magazine/en.html [L]

RewriteCond %{QUERY_STRING} (?:^|&)lang=fr(?:&|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/magazine/fr.html -f
RewriteRule ^magazine/?$ magazine/fr.html [L]

RewriteCond %{QUERY_STRING} (?:^|&)page=([0-9]+)(?:&|$) [NC]
RewriteCond %{DOCUMENT_ROOT}/magazine/page%1.html -f
RewriteRule ^magazine/?$ magazine/page%1.html [L]

# 1. Serve actual existing files and directories directly (images, PDFs, JS, CSS, pre-rendered HTML files, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Support clean URLs matching pre-rendered .html files if available
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# 3. Everything else (SPA client-side routes) -> fallback to root index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
